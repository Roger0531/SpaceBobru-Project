--- !u!114 &1354664070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1354664069}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0dd6893aa468e04792fd68c5d3abb0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EventManager
  events:
  - eventID: 1
    eventName: Problems with power!!!
    eventDescription: Solar panels stopped producing electricity, whole base is powered by the reserves. Send somebody for repairment, because reserves aren't endless.
    dayOccurs: 10
    hourOccurs: 10
    hoursTakes: 0
    energyCost: 0
    oxygenCost: 0
    foodCost: 0
    hpCost: 0
    subEventID: 0
    choices: []
    isCompleted: 0
  - eventID: 2
    eventName: Set up a retranslator
    eventDescription: Connection with MCS is lost. Send somebody to set up a retranslator and return the signal.
    dayOccurs: 1
    hourOccurs: 4
    hoursTakes: 4
    energyCost: 5
    oxygenCost: 3
    foodCost: 0
    hpCost: 1
    subEventID: 0
    choices: []
    isCompleted: 0
  - eventID: 3
    eventName: New signal
    eventDescription: Retranslator caught a signal of a lost rover. Get to it and extract data.
    dayOccurs: 5
    hourOccurs: 0
    hoursTakes: 12
    energyCost: 15
    oxygenCost: 9
    foodCost: 0
    hpCost: 1
    subEventID: 0
    choices:
    - choiceID: 1
      isFinal: 1
      hoursTakes: 12
      ChoiceText: Send somebody
      ChoiceDescription: 
      energyCost: 15
      oxygenCost: 9
      foodCost: 0
      hpCost: 1
    - choiceID: 2
      isFinal: 1
      hoursTakes: 0
      ChoiceText: Don't send anybody
      ChoiceDescription: 
      energyCost: 0
      oxygenCost: 0
      foodCost: 0
      hpCost: 0
    isCompleted: 0
  - eventID: 4
    eventName: Lunar venicle drop
    eventDescription: We finally got lunar venicle. While dropping, it raised the dust and solar panel energy production is decreased by 25%. Send somebody to clean it.
    dayOccurs: 1
    hourOccurs: 0
    hoursTakes: 4
    energyCost: 0
    oxygenCost: 0
    foodCost: 0
    hpCost: 1
    subEventID: 0
    choices: []
    isCompleted: 0
  - eventID: 5
    eventName: We got problems!!!
    eventDescription: Small meteor has just damaged our Life-support system and Distribution block. Before the night we can repair only one.
    dayOccurs: 3
    hourOccurs: 8
    hoursTakes: 8
    energyCost: 5
    oxygenCost: 0
    foodCost: 0
    hpCost: 0
    subEventID: 0
    choices:
    - choiceID: 1
      isFinal: 0
      hoursTakes: 0
      ChoiceText: 'Repair Life-support system '
      ChoiceDescription: You will lose 30% of energy immediatly and then every day 5% will be taken too.
      energyCost: 30
      oxygenCost: 0
      foodCost: 0
      hpCost: 0
    - choiceID: 2
      isFinal: 0
      hoursTakes: 0
      ChoiceText: Repair districbution block
      ChoiceDescription: -50% of Oxygen production
      energyCost: 0
      oxygenCost: 40
      foodCost: 0
      hpCost: 0
    isCompleted: 0
  - eventID: 6
    eventName: New problems!!!
    eventDescription: In food block we have fungus infection. Send a medical specialist to solve the problem.
    dayOccurs: 4
    hourOccurs: 0
    hoursTakes: 0
    energyCost: 0
    oxygenCost: 0
    foodCost: 0
    hpCost: 0
    subEventID: 0
    choices:
    - choiceID: 1
      isFinal: 1
      hoursTakes: 16
      ChoiceText: Clean the food
      ChoiceDescription: You send a specialist and food is saved.
      energyCost: 5
      oxygenCost: 0
      foodCost: 0
      hpCost: 1
    - choiceID: 2
      isFinal: 1
      hoursTakes: 0
      ChoiceText: Throw the food away
      ChoiceDescription: Make sure that nobody tries to it this food.
